#################
### CONSTANTS ###
#################

param pi=3.141592654
param degrad=$pi/180
param refP=179.0

param refXp=0.0
param refYp=0.0
######################
### INITIALIZATION ###
######################

randomseed time

#trace format=ascii

## decay/stochastics enabled:
#physics QGSP_BIC doStochastics=1
## disable=Decay

# decay/stochastics disabled:
physics QGSP_BIC doStochastics=0 

# Reference Particle (25th harmonic - 201.25 MHz)
reference particle=mu+ \
	beamX=0 \
	beamY=0 \
	beamZ=0.0 \
	beamXp=0 beamYp=0 \
	referenceMomentum=$refP

particlecolor reference=1,1,1

beam gaussian particle=mu+ nEvents=10000 beamX=0.0 beamY=0 beamZ=0 beamXp=$refXp  beamYp=$refYp \
     sigmaX=2.0 sigmaY=0.0 sigmaXp=0.03 sigmaYp=0.0 meanMomentum=$refP sigmaP=2.0 meanT=0.0 sigmaT=0.0

# kill secondaries
trackcuts killSecondaries=1

trace format=ascii nTrace=100 oneNTuple=1

############################
### GEOMETRY DEFINITIONS ###
############################

# FOFO channel
param maxStep=100.0
param drift=2860./2

genericquad fo1 fieldLength=100 ironLength=100 apertureRadius=200 \
	    ironRadius=600 gradient=4 
genericquad do1 fieldLength=100 ironLength=100 apertureRadius=200 \
	    ironRadius=600 gradient=-4 

# detector and filter
#declaring zntuple
#particlefilter filter radius=1000 length=0.001 color=1,1,1 kill=mu+ nWait=$nWait referenceWait=1
zntuple filename=refBeam2_179.txt format=ascii  z=0


################################
### ELEMENT PLACING SEQUENCE ###
################################

#newparticlentuple det0 file=det0.txt format=ascii

do i 1 10

place fo1 x=0 z=$drift*(2*$i-1)  y=0 
place do1 x=0 z=$drift*2*$i y=0
zntuple filename=refBeam2_179.txt format=ascii  z=$drift*2*$i+$drift/2.0


enddo


